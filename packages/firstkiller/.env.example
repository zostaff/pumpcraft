# === Solana RPC ===
# Helius WebSocket endpoint (wss://...) for log subscriptions
RPC_WSS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Helius HTTP endpoint for RPC calls
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=YOUR_KEY

# === Wallet ===
# Base58-encoded private key
WALLET_PRIVATE_KEY=

# === Trading ===
BACKRUN_BUY_SOL=0.1
BACKRUN_JITO_TIP=0.001
BACKRUN_TAKE_PROFIT=2.0
BACKRUN_STOP_LOSS=0.5
BACKRUN_TIMEOUT_SEC=60
BACKRUN_MIN_DEV_BUY=0.5
BACKRUN_MAX_POSITIONS=3
BACKRUN_COOLDOWN_SEC=5

# === Jito ===
JITO_BLOCK_ENGINE=https://mainnet.block-engine.jito.wtf
