RPC_URL=https://api.mainnet-beta.solana.com
# base58 64-byte secret key. Optional when DRY_RUN=true (ephemeral key; dry runs simulate as SIM_PAYER).
WALLET_PRIVATE_KEY=
BUY_SOL=0.05
RELAYS=sender,jito
JITO_TIP=auto
JITO_TIP_MAX=0.001
SENDER_TIP=0.000005
PRIORITY_FEE=auto
TAKE_PROFIT=2.0
STOP_LOSS=0.6
TRAILING_STOP=0.25
TIMEOUT_SEC=120
SLIPPAGE_PCT=15
EXIT_SLIPPAGE_PCT=40
MAX_POSITIONS=3
MAX_SESSION_LOSS=0.15
MAX_CONSECUTIVE_LOSSES=5
MIN_SOL_RESERVE=0.01
MAX_SIGNAL_AGE_MS=6000
DRY_RUN=true
# Optional overrides
# JITO_URLS=https://ny.mainnet.block-engine.jito.wtf,https://frankfurt.mainnet.block-engine.jito.wtf
# HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
# CU_LIMIT_BUY=90000
# CU_LIMIT_SELL=60000
# SOCKET_PATH=/tmp/mev-streamer.sock
