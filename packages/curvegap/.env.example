# ── RPC ──────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_WSS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=YOUR_KEY

# ── Wallet ───────────────────────────────────────────────────────────
# base58 secret key, JSON array ([1,2,...]) or a path to a keypair .json file
WALLET_PRIVATE_KEY=base58_private_key

# ── Jito ─────────────────────────────────────────────────────────────
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Optional address lookup table (create with: npm run alt:create)
ARB_LOOKUP_TABLE=

# ── Arbitrage ────────────────────────────────────────────────────────
ARB_MIN_SPREAD=0.02          # minimum spread to consider an opportunity (2%)
ARB_MAX_SOL=0.5              # max SOL per arbitrage trade
ARB_JITO_TIP=0.001           # Jito tip per bundle (SOL)
ARB_MIN_LIQUIDITY=1.0        # minimum liquidity on each venue (SOL)
ARB_MAX_SLIPPAGE=0.03        # max allowed slippage per leg (3%)
ARB_COOLDOWN_SEC=3           # pause between arbs on the same token
ARB_SCAN_INTERVAL_MS=2000    # price scan interval

# ── Advanced (optional) ──────────────────────────────────────────────
ARB_MIN_PROFIT=0.0005        # minimum net profit after fees + tip (SOL)
ARB_PRIORITY_MICROLAMPORTS=0 # compute unit price (Jito tip already pays for inclusion)
ARB_COMPUTE_UNITS=400000     # compute unit limit for the arb transaction
ARB_CURVE_FEE_BPS=           # override pump.fun total fee in bps (default: on-chain fee tiers)
ARB_AMM_FEE_BPS=             # override PumpSwap total fee in bps (default: on-chain fee tiers)
ARB_MAX_PAIRS=500            # max number of tracked dual-venue tokens
ARB_DISCOVERY_RPS=2          # max getProgramAccounts pool lookups per second
