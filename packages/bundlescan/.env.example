# --- Solana RPC ---
# A full-history / archival RPC is recommended for stats over a time window.
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WSS=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# --- Scanner ---
# Minimum extracted profit (SOL) for a detection to be reported.
SCAN_MIN_PROFIT=0.01
# Comma-separated DEX programs to inspect: pumpfun,pumpswap,raydium,orca
SCAN_PROGRAMS=pumpfun,pumpswap,raydium,orca

# --- Dashboard ---
DASHBOARD_PORT=3001

# --- Wallet guard ---
# Wallet to monitor for inbound sandwich attacks (wallet-guard default).
GUARD_WALLET=
# Alert when estimated victim loss (SOL) exceeds this threshold.
GUARD_ALERT_THRESHOLD=0.01

# --- Simulator ---
# Default notional (SOL) used by the analytical "what-if" simulator.
SIM_DEFAULT_AMOUNT=0.5
